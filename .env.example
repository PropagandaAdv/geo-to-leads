# Copia in .env (NON versionare .env). Mai committare chiavi reali.
# In cloud i file locali sono effimeri: i dati cliente vivono in un repo GitHub PRIVATO (es. propagandaadv/geo-clients)
# clonato/collegato alla sessione; GEO_CLIENTS_DIR = percorso del suo checkout.
GEO_CLIENTS_DIR=/home/user/geo-clients
# Dashboard (Supabase/Lovable Cloud): chiave service_role = segreto di ambiente, MAI in chat né nel repo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Arvow: chiave API (MCP e fallback REST). Endpoint MCP da verificare nella doc Arvow.
ARVOW_API_KEY=
# Lead Radar modalità A (solo se il fornitore conferma un'API)
LEADRADAR_API_KEY=
LEADRADAR_API_BASE=
# Lead Radar modalità C (parsing alert via IMAP)
LEADRADAR_IMAP_HOST=
LEADRADAR_IMAP_USER=
LEADRADAR_IMAP_PASSWORD=
LEADRADAR_IMAP_FOLDER=INBOX
